{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Port Forwarder",
  "version": "0.2.5",
  "identifier": "com.codex.ssh-port-forwarder",
  "build": {
    "beforeDevCommand": "npm.cmd --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm.cmd --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSH Port Forwarder",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": []
  }
}
